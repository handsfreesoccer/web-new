# Turso (hosted SQLite). This is the only database — nothing is stored locally.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=""

# Optional coach contact shown in payment-note emails
# HEAD_COACH_NAME="Head Coach"
# HEAD_COACH_EMAIL="handsfreesoccer@gmail.com"
# HEAD_COACH_PHONE="(469) 288-2265"

# Cloudflare R2 (S3-compatible object storage)
# From R2 → Manage R2 API Tokens → Create API token (Object Read & Write):
#   Access Key ID     → R2_ACCESS_KEY_ID
#   Secret Access Key → R2_SECRET_ACCESS_KEY
# The separate Cloudflare "Token value" is for the REST API, not this app.
# Account ID is on the R2 overview page in Cloudflare.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="website-content"
# Public CDN/base URL for R2 objects (server-only; API responses include full URLs).
R2_PUBLIC_URL="https://your-bucket-or-custom-domain.example.com"
