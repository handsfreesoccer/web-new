generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Booking {
  id                  Int          @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String
  phone               String
  classType           String
  appointmentStartUtc DateTime
  appointmentEndUtc   DateTime?
  welcomeSentAt       DateTime?
  reminderSentAt      DateTime?
  paymentSentAt       DateTime?
  paidAt              DateTime?
  createdAt           DateTime     @default(now())
  attendances         Attendance[]
  emailLogs           EmailLog[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attendedAt DateTime
  createdAt DateTime @default(now())
}

model EmailLog {
  id           Int      @id @default(autoincrement())
  bookingId    Int?
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type         String
  status       String
  providerId   String?
  scheduledFor DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime @default(now())
}

model BookingAvailability {
  id            Int      @id @default(1)
  /// JSON array of weekday keys, e.g. ["monday","tuesday",…]
  availableDays String   @default("[\"monday\",\"tuesday\",\"wednesday\",\"thursday\",\"friday\"]")
  /// Local time window start, HH:mm
  startTime     String   @default("09:00")
  /// Local time window end, HH:mm
  endTime       String   @default("17:00")
  /// Slot interval in minutes: 5, 15, 30, or 60
  minuteStep    Int      @default(30)
  /// Minimum hours before an appointment can be booked
  minNoticeHours Int     @default(24)
  /// Maximum days ahead a booking can be made
  maxAdvanceDays Int     @default(30)
  updatedAt     DateTime @updatedAt
}
